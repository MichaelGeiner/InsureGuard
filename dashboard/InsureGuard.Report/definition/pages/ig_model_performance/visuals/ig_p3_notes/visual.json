            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "How the model was built",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "13pt",
                      "color": "#0B2545"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Isolation Forest (unsupervised) + XGBoost (supervised), blended 20/80 into a 0 to 100 risk score.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#1B2733"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Out-of-time validation: no future data used in training or features.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#1B2733"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  1.2% fraud rate handled with class weighting instead of SMOTE, so every training row stays real.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#1B2733"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Limitation: friendly fraud (customers disputing their own purchases) leaves no behavioral signal and needs chargeback investigation.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#1B2733"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
